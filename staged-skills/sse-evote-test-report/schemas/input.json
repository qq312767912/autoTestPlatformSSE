{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workflow_id",
    "plan_output_ids",
    "case_output_ids",
    "execution_output_ids",
    "output_root"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_output_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "case_output_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_output_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "test_results_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
