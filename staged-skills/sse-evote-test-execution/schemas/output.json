{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workflow_id",
    "stage",
    "parent_output_ids",
    "coverage",
    "pass_rate",
    "results",
    "artifacts"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "stage": {
      "const": "test_execution"
    },
    "parent_output_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "status"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
