{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workflow_id",
    "case_output_id",
    "test_cases_artifact",
    "output_root"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "case_output_id": {
      "type": "string",
      "minLength": 1
    },
    "test_cases_artifact": {
      "type": "string",
      "minLength": 1
    },
    "output_root": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "test",
        "uat",
        "prod"
      ]
    },
    "execution_policy": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
